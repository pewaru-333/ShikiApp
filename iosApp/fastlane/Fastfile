default_platform(:ios)

def read_gradle_property(property_name)
  file_path = File.expand_path("../../gradle.properties", __dir__)
  if File.exist?(file_path)
    File.readlines(file_path).each do |line|
      if line.strip.start_with?(property_name + "=") || line.strip.start_with?(property_name + " =")
        return line.split('=', 2).last.strip
      end
    end
  end
  UI.user_error!("Could not find #{property_name} in gradle.properties")
end

platform :ios do

  desc "Phase 1: Build the iOS app and generate an .ipa file"
  lane :build_ios_release do
    ENV["APP_USER_AGENT"] = "DarkShiki"
    profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME", "appstore release2")
    raw_version_name = read_gradle_property("APP_VERSION_NAME")
    version_code = read_gradle_property("APP_VERSION_CODE")
    clean_version_name = raw_version_name.include?("-") ? raw_version_name.split("-").last : raw_version_name

    UI.message("Applying Version: #{clean_version_name} and Build: #{version_code} to iOS project...")

    increment_version_number(version_number: clean_version_name, xcodeproj: File.expand_path("../iosApp.xcodeproj", __dir__))
    increment_build_number(build_number: version_code, xcodeproj: File.expand_path("../iosApp.xcodeproj", __dir__))

    build_app(
      project: File.expand_path("../iosApp.xcodeproj", __dir__),
      scheme: "iosApp",
      configuration: "DarkShiki Release",
      clean: true,
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      xcargs: {
        "APP_USER_AGENT" => "DarkShiki",
        "CODE_SIGN_STYLE" => "Manual",
        "DEVELOPMENT_TEAM" => "2AN324X242",
        "PROVISIONING_PROFILE_SPECIFIER" => profile_name
      },
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: "2AN324X242",
        provisioningProfiles: {
          "rip.shiki.app" => profile_name
        }
      },
      output_directory: File.expand_path("../build", __dir__),
      output_name: "ShikiRip.ipa"
    )
  end

  desc "Phase 3: Deploy the pre-built .ipa to App Store Connect"
  lane :deploy_ios_release do
    version_code = read_gradle_property("APP_VERSION_CODE")
    changelog_path = File.expand_path("../../fastlane/metadata/android/ru/changelogs/#{version_code}.txt", __dir__)
    changelog_text = File.exist?(changelog_path) ? File.read(changelog_path).strip : ""
    changelog_text = "— Это техническое обновление без изменений в интерфейсе." if changelog_text.empty()

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      in_house: false
    )

    upload_to_app_store(
      ipa: File.expand_path("../build/ShikiRip.ipa", __dir__),
      app_identifier: "rip.shiki.app",
      submit_for_review: true,
      force: true,
      automatic_release: true,
      skip_metadata: false,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      release_notes: {
        "ru" => changelog_text,
        "en-US" => changelog_text
      }
    )
  end
end